{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moontv",
  // 使用自定义入口，以便额外暴露 Cron Triggers 需要的 scheduled handler
  "main": "./custom-worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    // 启用 Node.js API
    "nodejs_compat",
    // 允许应用内 fetch 外部 URL
    "global_fetch_strictly_public"
  ],
  // 非敏感变量；USERNAME / PASSWORD 等敏感值请用 `wrangler secret put` 设置
  "vars": {
    "NEXT_PUBLIC_STORAGE_TYPE": "d1"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moontv",
      "database_id": "2445271d-f962-4f0b-a686-880301589d8f"
    }
  ],
  "triggers": {
    // 等价于原 vercel.json 中的 crons：每天 01:00 (UTC) 调用 /api/cron
    "crons": ["0 1 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
